<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jfs.sumsurfers — nightly clip collection, detection, predictors and chart.

  Replaces the 20:30 crontab entry. The reason for launchd over cron: if the
  Mac is asleep at the scheduled time, launchd runs the job at the next wake,
  while cron silently skips the day and waits 24 hours. That is exactly what
  cost 2026-09-14's chart. Nothing wakes this Mac for 20:30 — the only
  repeating wake is 18:25 on weekdays, paired with another project's agent —
  so catch-up-on-wake is what makes this schedule dependable, especially at
  weekends.

  caffeinate -i holds off idle sleep for as long as the pipeline runs, which
  now includes the chart as its last step.

  Install (do this only after tonight's cron run has finished, and remove the
  crontab line in the same sitting so the job cannot fire twice):

    cp code/launchagents/com.jfs.sumsurfers.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jfs.sumsurfers.plist
    crontab /tmp/crontab.empty        # or: crontab -e, delete the 20:30 line

  Verify it is registered:
    launchctl print gui/$(id -u)/com.jfs.sumsurfers | head -20

  REQUIRES Full Disk Access for /bin/bash. Verified 2026-09-16: without it a
  launchd-spawned bash cannot even list ~/Documents/DS/sum-surfers/data. Grant
  it in System Settings > Privacy & Security > Full Disk Access > + >
  Cmd-Shift-G > /bin/bash. This is separate from the existing grants for
  /usr/sbin/cron and the Python binary.

  Run it once by hand (the Full Disk Access test):
    launchctl kickstart -k gui/$(id -u)/com.jfs.sumsurfers
    tail -5 /tmp/sumsurfers_launchd.log          # spawn-time errors
    tail -5 data/local_pipeline.log              # the run itself

  Uninstall:
    launchctl bootout gui/$(id -u)/com.jfs.sumsurfers
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jfs.sumsurfers</string>

    <!--
      The log is opened by bash inside the job, not by launchd via
      StandardOutPath. launchd could not open a file under ~/Documents at all
      (TCC), and that failed the job before it started: exit 78 EX_CONFIG,
      "spawn failed", with nothing written anywhere. bash holding Full Disk
      Access can open it, so the log stays in the repo where it has always
      lived.
    -->
    <!--
      bash is the lead process, not caffeinate. TCC attributes a job's file
      access to the executable launchd starts, so with caffeinate leading, the
      Full Disk Access granted to /bin/bash did not apply and every path under
      ~/Documents came back "Operation not permitted" — including the script
      itself. Verified 2026-09-16: a probe agent running bash directly reads
      the same paths fine.

      Idle sleep is still held off, by `caffeinate -i -w $$`: it waits on this
      bash process and exits with it, covering the whole run exactly as the old
      `caffeinate -i <script>` crontab wrapper did. It is backgrounded rather
      than exec'd so that bash stays the lead process.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec &gt;&gt; /Users/jfs-m3/Documents/DS/sum-surfers/data/local_pipeline.log 2&gt;&amp;1; /usr/bin/caffeinate -i -w $$ &amp; exec /Users/jfs-m3/Documents/DS/sum-surfers/code/local_pipeline.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!--
      Deliberately in /tmp, outside every TCC-protected folder: this only
      catches failures that happen before bash redirects, which is exactly the
      case that produced a silent spawn failure. Real pipeline output goes to
      data/local_pipeline.log via the redirect above.
    -->
    <key>StandardOutPath</key>
    <string>/tmp/sumsurfers_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/sumsurfers_launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Never run on load: loading it should not kick off a pipeline run. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
