# .env.example — copy to .env and fill in real values
# NEVER commit .env to git (it is already in .gitignore)

# Surfline API credentials
SURFLINE_CAMERA_ID=your_camera_id_here
SURFLINE_ACCESS_TOKEN=your_access_token_here

# Optional: override the model weights path (defaults to the path baked into detect_surfers.py)
# MODEL_PATH=/home/surfer/sum-surfers/data/model_out/20251013/train/runs/detect/train13/weights/best.pt

# ── Email alerts (Gmail SMTP + App Password) ─────────────────────────────────
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
EMAIL_TO=joelfsilverman@gmail.com

# ── Storage limits ───────────────────────────────────────────────────────────
# Local clips folder warning threshold (GB)
CLIPS_DIR_LIMIT_GB=2.0
# VM data directory warning threshold (GB)
VM_DATA_LIMIT_GB=50

# ── GCP config (used by local_pipeline.sh) ───────────────────────────────────
GCP_PROJECT=sum-surfers-20260510-a1b2
GCP_ZONE=us-west2-a
GCP_INSTANCE=surf-detector

# ── Detection behaviour ──────────────────────────────────────────────────────
# DETECT_MODE: recent (default) | all | start-date
# DETECT_RECENT_DAYS=7
# DETECT_START_DATE=2025-10-01

# ── Reminder threshold ───────────────────────────────────────────────────────
# Days without a local run before the VM emails a reminder (default: 4)
# REMINDER_THRESHOLD_DAYS=4
