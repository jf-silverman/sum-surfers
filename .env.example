# .env.example — copy to .env and fill in real values
# NEVER commit .env to git (it is already in .gitignore)

# ── Surfline clip API (OPTIONAL) ─────────────────────────────────────────────
# Needed ONLY by get_clips.py, which downloads recorded clips, and therefore by
# local_pipeline.sh. Everything else in this repo runs without them:
# watch_live.py collects from the public live stream, and the detector and
# forecast demos read no environment at all.
#
# This pair buys the RECENT PAST. The live stream is public and free but gives
# you only the moment you are watching; pulling the hours you missed uses
# Surfline's recorded-clip endpoint, which needs a PAID SUBSCRIPTION. The window
# is short either way -- the camera keeps five days including today, so four
# days back is the furthest anyone can reach, subscription or not.
#
# Leave them empty if you are not using the clip path. get_clips.py checks for
# them inside clip_api_url() rather than at import, so an empty value fails with
# a message naming what is missing, only when that step actually runs, and
# blocks nothing else.
SURFLINE_CAMERA_ID=
SURFLINE_ACCESS_TOKEN=

# Optional: override the model weights path (defaults to the path baked into detect_surfers.py)
# MODEL_PATH=/home/surfer/sum-surfers/data/model_out/20251013/train/runs/detect/train13/weights/best.pt

# ── Email alerts (Gmail SMTP + App Password) ─────────────────────────────────
SMTP_USER=your_gmail_address@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
EMAIL_TO=your_email_here

# ── Storage limits ───────────────────────────────────────────────────────────
# Local clips folder warning threshold (GB)
CLIPS_DIR_LIMIT_GB=2.0

# ── Detection behaviour ──────────────────────────────────────────────────────
# DETECT_MODE: recent (default) | all | start-date
# DETECT_RECENT_DAYS=7
# DETECT_START_DATE=2025-10-01

# ── Historical predictor backfill (code/backfill_historical_predictors.py) ──
# Manual/occasional use only — NOT read by the scheduled pipeline. This is
# your personal Surfline session's auth token (from a logged-in, premium
# account), not a public API key — grab a fresh one from Chrome DevTools
# (Network tab -> any services.surfline.com request -> Headers ->
# x-auth-accesstoken) each time you run a backfill; it may go stale between
# sessions. Leave commented out to be prompted for it at runtime instead.
# SURFLINE_HISTORICAL_TOKEN=your_session_accesstoken_here
